{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {"analytics": false},
  "projects": {
    "sinalfrio": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "index": "src/index.html",
            "styles": ["src/styles.css"],
            "tsConfig": "tsconfig.json",
            "outputPath": "dist/sinalfrio"
          }
        },
        "serve": {"builder": "@angular/build:dev-server", "options": {"buildTarget": "sinalfrio:build"}}
      }
    }
  }
}
